# Ollama connection
# Cloud example:
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=your_ollama_api_key

# Local example (uncomment these and remove the cloud API key if using local Ollama):
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Speech input and spoken output
SPEECH_RECOGNITION_LANGUAGE=en-US
SPEECH_TIMEOUT=5
# Edge neural voice name (for example, en-US-AriaNeural or en-US-GuyNeural).
TTS_VOICE=en-US-AriaNeural
# Speech speed adjustment such as +0%, +10%, or -10%.
TTS_RATE=+0%

# Number of recent user/assistant exchanges retained for context.
CONVERSATION_HISTORY_TURNS=10
